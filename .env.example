# 必填：模型服务的 API Key（默认是硅基流动：https://cloud.siliconflow.cn/account/ak）
AI_API_KEY=

# 选填：OpenAI 兼容接口地址，默认 https://api.siliconflow.cn/v1
# AI_BASE_URL=https://openrouter.ai/api/v1

# 选填：可选模型列表，英文逗号分隔，第一个为默认模型。
# 使用默认的硅基流动时可不填；改了 AI_BASE_URL 就必须填。
# AI_MODELS=Qwen/Qwen3-8B,THUDM/GLM-4-9B-0414

# 选填：支持识图的模型（会额外显示上传图片按钮）
# AI_VISION_MODELS=

# 选填：访问密码，设置后需输入密码才能对话
# APP_PASSWORD=

# 选填：网站标题
# SITE_NAME=我的 AI 助手
